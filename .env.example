# Public project endpoint and public browser key used by Supabase Auth.
# Security is enforced by authenticated sessions and Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-or-publishable-key

# Optional future server-only secrets. The current application does not read them.
SUPABASE_SERVICE_ROLE_KEY=do-not-configure-unless-a-server-job-requires-it
ATSOC_ENCRYPTION_KEY=generate-a-32-byte-random-secret-if-needed
